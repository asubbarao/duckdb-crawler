# name: test/sql/crawl_url.test
# description: Test crawl_url() bare (source mode) and in LATERAL joins
# group: [crawler]

require crawler

# Bare call must return exactly one row and terminate (regression: infinite re-crawl loop)
query I
SELECT count(*) FROM crawl_url('https://example.com/');
----
1

query I
SELECT status FROM crawl_url('https://example.com/');
----
200

# LATERAL join, including duplicate URLs
query I
SELECT count(*)
FROM (VALUES ('https://example.com/'), ('https://example.com/')) t(u),
     LATERAL crawl_url(t.u) c;
----
2
